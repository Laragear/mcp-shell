{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["src/**", "tests/**", "package.json", "tsconfig.json", "biome.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        // Config files and YAML are untrusted input: values are validated at
        // runtime (validateConfig), types stop at the parse boundary.
        "noExplicitAny": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  }
}
